# Browser requests use /api and are forwarded by Vite to the Spring backend.
# Spring Boot's default server port is 8081. Override this if your backend
# runs with the existing-db profile, which listens on 8082.
VITE_API_PROXY_TARGET=http://localhost:8081

# For a separately hosted frontend, replace /api with the reachable backend URL,
# for example: VITE_API_BASE_URL=https://api.example.com/api
# VITE_API_BASE_URL=/api
